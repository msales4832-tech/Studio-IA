# Copie este arquivo para ".env" (que o git ignora) e preencha os valores.
# NUNCA comite o .env. NUNCA cole o token em chat.

# Token do bot, obtido com @BotFather no Telegram.
# Se o token ja vazou em algum lugar (chat, print), gere um novo em @BotFather -> /revoke.
TELEGRAM_BOT_TOKEN=

# Seu ID numerico de usuario no Telegram (so VOCE podera usar o bot).
# Descubra enviando /start para @userinfobot no Telegram.
TELEGRAM_ALLOWED_USER_ID=

# Abrir o navegador visivel (false) para voce logar na primeira vez,
# ou sem janela (true) depois que as sessoes ja estao salvas no perfil.
HEADLESS=false

# Porta local (so 127.0.0.1) onde a IA pede um login novo. 0 desliga.
CONTROLE_PORTA=8765

# Pasta onde o Claude trabalha nas tarefas mandadas pelo Telegram (texto livre).
# Edicoes so dentro dela; o resto pede o seu botao no Telegram. Vazio = ~/bot-remoto-tarefas
TAREFAS_DIR=
# Caminho do claude.exe. Vazio = o mais novo instalado pelo app do Claude.
CLAUDE_EXE=

# Porta local (so 127.0.0.1) do navegador, para a IA controlar a pagina aberta.
# Qualquer programa deste PC pode usar essa porta enquanto o navegador estiver aberto. 0 desliga.
CDP_PORTA=9222
